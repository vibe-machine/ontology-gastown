{
  "name": "gastown",
  "displayName": "Gastown Agent Orchestration",
  "version": "1.0.0",
  "description": "Multi-agent orchestration domain for AI worker coordination. Defines Agent types (Polecat, Witness, Refinery) and workspaces (Rig) for parallel AI development.",
  "author": "vibe-machine",
  "license": "MIT",
  "source": "https://github.com/vibe-machine/ontology-gastown",
  "prefix": "gastown",
  "schemas": [
    {
      "name": "self-describing-schema",
      "file": "schema/self-describing-schema.tql"
    },
    {
      "name": "package-provenance",
      "file": "schema/package-provenance.tql"
    },
    {
      "name": "gastown",
      "file": "schema/gastown.tql"
    }
  ],
  "data": [
    "data/gastown-provenance.tql",
    "data/gastown-schema-docs.tql"
  ],
  "dependencies": [
    {
      "name": "gist",
      "version": ">=1.0.0"
    },
    {
      "name": "beads",
      "version": ">=0.59.0"
    }
  ],
  "scripts": {
    "refresh:package-contract": "node ../ontology-gist/tools/package_contract/bootstrap_hand_authored_package.mjs .",
    "validate:bootstrap": "node tools/package_contract/validate_bootstrap.mjs",
    "test:typedb-bootstrap": "node tools/package_contract/validate_typedb_bootstrap.mjs",
    "test": "npm run validate:bootstrap && npm run test:typedb-bootstrap",
    "release": "../ontology-tooling/bin/ontology-release --repo .",
    "release:check": "../ontology-tooling/bin/ontology-release --repo . --validate-only"
  },
  "manifests": [
    "manifests/gastown-v1.0.0.package-manifest.json"
  ],
  "assembly": {
    "loadOrder": [
      "schema/self-describing-schema.tql",
      "schema/package-provenance.tql",
      "schema/gastown.tql",
      "data/gastown-provenance.tql",
      "data/gastown-schema-docs.tql"
    ],
    "generatedArtifacts": [
      "schema/self-describing-schema.tql",
      "schema/package-provenance.tql",
      "data/gastown-schema-docs.tql",
      "data/gastown-provenance.tql",
      "manifests/package-manifest.schema.json",
      "manifests/gastown-v1.0.0.package-manifest.json"
    ]
  },
  "provenance": {
    "manifest": "manifests/gastown-v1.0.0.package-manifest.json",
    "status": "bootstrap"
  },
  "legacyDocumentation": {
    "deprecatedFiles": [
      "data/gastown-typedoc.tql",
      "data/domains.tql",
      "data/categorize.tql"
    ],
    "status": "superseded-by-schema-resource"
  }
}
