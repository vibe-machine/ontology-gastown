insert

# =============================================================================
# Agent Entities
# =============================================================================

$agent_doc isa TypeDoc,
    has typeLabel "Agent",
    has typeKind "entity",
    has definition "Abstract base type for AI agents in the Gas Town multi-agent orchestration system. Agents are autonomous workers that can claim beads, perform work, and coordinate with other agents.",
    has usageNote "Agent extends Category since agents categorize themselves by role. Do not instantiate Agent directly; use concrete subtypes like Polecat, Witness, or Mayor.";

$polecat_doc isa TypeDoc,
    has typeLabel "Polecat",
    has typeKind "entity",
    has definition "An ephemeral worker agent that claims and executes beads. Polecats are spawned by the Witness, work in isolated git worktrees, and are terminated after completing their assigned work.",
    has usageNote "Polecat is the primary worker agent type. Each polecat has a unique name, works in a specific rig, and tracks its state (working, done, stuck). The clonePath attribute points to its git worktree.";

$witness_doc isa TypeDoc,
    has typeLabel "Witness",
    has typeKind "entity",
    has definition "A monitoring and orchestration agent that oversees a rig. The Witness watches for ready beads, spawns polecats to work on them, monitors progress, and handles completion or escalation.",
    has usageNote "Each rig has at most one Witness. Configure maxWorkers to limit parallel polecats. The autoSpawn attribute controls whether polecats are spawned automatically or manually triggered.";

$refinery_doc isa TypeDoc,
    has typeLabel "Refinery",
    has typeKind "entity",
    has definition "A specialized agent that handles merge operations. The Refinery monitors ready_to_merge beads, validates PRs, runs final checks, and merges approved work to the main branch.",
    has usageNote "Refinery agents ensure code quality gates are met before merging. They coordinate with the Witness to prevent conflicts during parallel merges.";

$mayor_doc isa TypeDoc,
    has typeLabel "Mayor",
    has typeKind "entity",
    has definition "A town-level orchestrator agent that coordinates work across multiple rigs. The Mayor handles cross-project dependencies, resource allocation, and high-level planning.",
    has usageNote "Mayor is optional for single-rig setups. Use Mayor when coordinating work across multiple repositories or when implementing organization-wide policies.";

$deacon_doc isa TypeDoc,
    has typeLabel "Deacon",
    has typeKind "entity",
    has definition "A town-level coordinator agent that handles administrative tasks and communication. The Deacon manages agent lifecycle events, broadcasts status updates, and maintains system health.",
    has usageNote "Deacon complements Mayor by handling operational concerns while Mayor handles strategic planning.";

# =============================================================================
# Workspace Entities
# =============================================================================

$rig_doc isa TypeDoc,
    has typeLabel "Rig",
    has typeKind "entity",
    has definition "A git repository workspace containing beads and associated agents. A rig represents a single project or codebase where AI agents perform work. Each rig has its own Witness, optional Refinery, and pool of Polecats.",
    has usageNote "Rig extends Organization from gist. The rigPath attribute is the local filesystem path; gitUrl is the remote repository URL. Configure hasWitness, hasRefinery, hasMayor to control which agents are active.";

$crew_worker_doc isa TypeDoc,
    has typeLabel "CrewWorker",
    has typeKind "entity",
    has definition "A human-managed workspace within a rig. CrewWorkers represent human developers who work alongside AI agents, each with their own clone of the repository.",
    has usageNote "CrewWorker extends Person. Use crewMembership relation to associate with a Rig. The clonePath and branch attributes track the human's working state.";

# =============================================================================
# Relations
# =============================================================================

$works_in_doc isa TypeDoc,
    has typeLabel "worksIn",
    has typeKind "relation",
    has definition "Associates a worker (Polecat) with the workspace (Rig) where it operates. Roles: worker (the Polecat), workspace (the Rig).",
    has usageNote "Each Polecat works in exactly one Rig. The relation is created when the Polecat is spawned and removed when it terminates.";

$assigned_work_doc isa TypeDoc,
    has typeLabel "assignedWork",
    has typeKind "relation",
    has definition "Assigns a bead to a worker agent. Roles: worker (the Polecat), assignedBead (the Bead being worked on).",
    has usageNote "A Polecat typically has one assigned bead at a time. The Witness creates this relation when dispatching work.";

$monitors_doc isa TypeDoc,
    has typeLabel "monitors",
    has typeKind "relation",
    has definition "Associates a Witness agent with the Rig it oversees. Roles: monitor (the Witness), monitoredRig (the Rig).",
    has usageNote "Each Rig has at most one Witness monitoring it. The Witness watches for state changes and orchestrates polecat lifecycle.";

$crew_membership_doc isa TypeDoc,
    has typeLabel "crewMembership",
    has typeKind "relation",
    has definition "Associates human crew members with their rig. Roles: member (the CrewWorker), crew (the Rig they belong to).",
    has usageNote "Crew members are humans who work in the same repository as AI agents. They can claim beads, review polecat work, and merge PRs.";

# =============================================================================
# Key Attributes
# =============================================================================

$polecat_name_doc isa TypeDoc,
    has typeLabel "polecatName",
    has typeKind "attribute",
    has definition "Unique identifier for a Polecat agent, typically auto-generated when spawned (e.g., polecat-a1b2c3).",
    has usageNote "polecatName is the @key attribute for Polecat. Used to identify the agent in logs, worktree paths, and tmux sessions.";

$polecat_state_doc isa TypeDoc,
    has typeLabel "polecatState",
    has typeKind "attribute",
    has definition "Current operational state of a Polecat: working (actively processing), done (completed successfully), stuck (encountered blocking issue).",
    has usageNote "The Witness monitors polecatState to detect completion or problems. A stuck polecat may need human intervention or reassignment.";

$rig_name_doc isa TypeDoc,
    has typeLabel "rigName",
    has typeKind "attribute",
    has definition "Human-readable name for a Rig, typically the repository name (e.g., dots, my-project).",
    has usageNote "rigName is the @key attribute for Rig. Used in CLI commands, logs, and agent coordination.";

$witness_state_doc isa TypeDoc,
    has typeLabel "witnessState",
    has typeKind "attribute",
    has definition "Operational state of a Witness: stopped (not running), running (actively monitoring), paused (temporarily halted).",
    has usageNote "Control Witness behavior with this state. Pausing prevents new polecat spawns but allows existing work to complete.";
